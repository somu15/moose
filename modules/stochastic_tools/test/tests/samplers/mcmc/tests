[Tests]
  issues = '#23837'
  design = 'ParallelMarkovChainMonteCarloBase.md'
  [mcmc_sampling]
    requirement = 'The system shall be be able to perform MCMC sampling when '
    [pmcmc_base]
      type = 'JSONDiff'
      input = main_base.i
      allow_test_objects = true
      jsondiff = 'mcmc_base.json'
      detail = 'using the base MCMC class; '
    []
    [pmcmc_base_bounds]
      type = 'JSONDiff'
      input = main_base.i
      allow_test_objects = true
      jsondiff = 'mcmc_base_bounds.json'
      cli_args = "Samplers/sample/lb='-2.0 -2.0' Samplers/sample/ub='2.0 2.0' Outputs/file_base='mcmc_base_bounds'"
      detail = 'using the base MCMC class with bounds specified; '
    []
  []
  [errors]
    requirement = 'The system shall throw an error when '
    [pmcmc_base_bounds1]
      type = RunException
      input = main_base.i
      cli_args = "Samplers/sample/lb='-2.0 -2.0'"
      detail = 'only the lower bounds specified; '
      expect_err = "Both lower and upper bounds should be specified."
    []
    [pmcmc_base_bounds2]
      type = RunException
      input = main_base.i
      cli_args = "Samplers/sample/lb='-2.0 -2.0' Samplers/sample/ub='2.0'"
      detail = 'the specified bounds are not of the same size; '
      expect_err = "Lower and upper bounds should be of the same size."
    []
    [pmcmc_base_bounds3]
      type = RunException
      input = main_base.i
      cli_args = "Samplers/sample/lb='-2.0' Samplers/sample/ub='2.0'"
      detail = 'the specified bounds are not equal to the size of the priors; '
      expect_err = "The bounds and priors should be of the same size."
    []
  []
[]
